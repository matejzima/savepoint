# Copy this file to .env and fill in real values. .env itself is gitignored.

# ntfy notifications (optional). Leave blank to disable, Savepoint silently
# skips notifications if NTFY_URL or NTFY_TOPIC are unset.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=savepoint-yourhomelab
# Only needed if your ntfy instance requires auth. Leave blank otherwise.
NTFY_TOKEN=

# Only needed when deploying MODE=agent (see docker-compose.agent.yml). Generate with
# e.g. `openssl rand -hex 32`, and enter the exact same value in master's own /agents
# "Add agent" form, master has no way to read this from the agent's own deployment.
AGENT_TOKEN=

# Optional, off by default (no auth). The exact header name your forward-auth proxy
# (e.g. Authentik, Traefik forward-auth) sets on authenticated requests, e.g.
# X-Authentik-Username. When set, Savepoint requires that header on every request.
# CAVEAT: this is presence-only checking, there is no signature or cryptographic
# binding to the proxy's own session. Protection depends entirely on the network
# guaranteeing that only the proxy can reach this port, never a direct request. If
# direct access is ever possible, anyone can set this header themselves and
# authenticate as anyone.
FORWARD_AUTH_HEADER=
